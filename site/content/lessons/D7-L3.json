n,\n       AVG(weighted_reach / weighted_base) AS reach_pct\nFROM research.research_gold.nat_metrics\nGROUP BY region;\n","code_lines":["<span class=\"k\">SELECT</span><span class=\"w\"> </span><span class=\"n\">region</span><span class=\"p\">,</span>","<span class=\"w\">       </span><span class=\"k\">AVG</span><span class=\"p\">(</span><span class=\"n\">weighted_reach</span><span class=\"w\"> </span><span class=\"o\">/</span><span class=\"w\"> </span><span class=\"n\">weighted_base</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">reach_pct</span>","<span class=\"k\">FROM</span><span class=\"w\"> </span><span class=\"n\">research</span><span class=\"p\">.</span><span class=\"n\">research_gold</span><span class=\"p\">.</span><span class=\"n\">nat_metrics</span>","<span class=\"k\">GROUP</span><span class=\"w\"> </span><span class=\"k\">BY</span><span class=\"w\"> </span><span class=\"n\">region</span><span class=\"p\">;</span>"],"difficulty":3,"fix_brief":{"avoid_html":["An AVG of ratios weights every subgroup equally."],"checks":[],"include_html":["Use SUM(weighted_reach) / NULLIF(SUM(weighted_base), 0)."],"must_html":[],"shape":[],"shape_note":"","steps_html":["Change only the line you marked, and the lines it affects.","Keep the rest of the code as it is.","Tap Run checks. A failed check tells you what is still wrong."]},"fix_checker":{"comments":"sql","kind":"text","rules":[{"id":"total_over_total","message":"Use SUM(weighted_reach) / NULLIF(SUM(weighted_base), 0).","pattern":"SUM\\(\\s*weighted_reach\\s*\\)\\s*/\\s*NULLIF\\(\\s*SUM\\(\\s*weighted_base\\s*\\)\\s*,\\s*0\\s*\\)","type":"required"},{"id":"no_avg","message":"An AVG of ratios weights every subgroup equally.","pattern":"AVG\\(","type":"forbidden"}]},"hints":["Does each subgroup weigh the same in AVG?","Should it?","Total over total."],"hints_html":["Does each subgroup weigh the same in AVG?","Should it?","Total over total.